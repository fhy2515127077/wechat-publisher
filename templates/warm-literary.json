{
    "name": "暖色文艺",
    "description": "衬线字体、暖棕左侧竖线、首行缩进、文学散文风",
    "body": {
        "max_width": "100%",
        "font_size": "15px",
        "color": "#4a4a4a",
        "line_height": "1.8",
        "font_family": "Georgia, 'Noto Serif SC', 'Source Han Serif SC', 'STSong', 'SimSun', serif",
        "letter_spacing": "0.8px",
        "word_break": "break-word",
        "padding": "0 8px",
        "background": "#fffdf7",
        "text_align": "justify"
    },
    "title": {
        "font_size": "22px",
        "font_weight": "bold",
        "color": "#2c2c2c",
        "text_align": "center",
        "margin": "0 0 24px 0",
        "line_height": "1.4"
    },
    "author": {
        "font_size": "13px",
        "color": "#999999",
        "text_align": "center",
        "margin": "0 0 24px 0"
    },
    "date": {
        "font_size": "12px",
        "color": "#bbbbbb",
        "text_align": "center",
        "margin": "0 0 20px 0"
    },
    "h1": {
        "font_size": "20px",
        "font_weight": "bold",
        "color": "#8b4513",
        "margin": "36px 0 16px 0",
        "padding": "8px 0 8px 14px",
        "border_left": "4px solid #d4a574",
        "background": "#fdf6ee",
        "text_align": "left"
    },
    "h2": {
        "font_size": "18px",
        "font_weight": "bold",
        "color": "#8b4513",
        "margin": "32px 0 14px 0",
        "padding": "8px 0 8px 14px",
        "border_left": "4px solid #d4a574",
        "background": "#fdf6ee",
        "text_align": "left"
    },
    "h3": {
        "font_size": "16px",
        "font_weight": "bold",
        "color": "#8b4513",
        "margin": "24px 0 12px 0",
        "text_align": "left"
    },
    "p": {
        "margin": "0 0 24px 0",
        "line_height": "1.8",
        "text_indent": "2em"
    },
    "strong": {
        "color": "#8b4513",
        "font_weight": "bold",
        "background": "transparent",
        "padding": "0",
        "border_radius": "0"
    },
    "em": {
        "color": "#8b4513",
        "font_style": "italic"
    },
    "a": {
        "color": "#8b4513",
        "text-decoration": "underline"
    },
    "blockquote": {
        "border_left": "4px solid #d4a574",
        "padding": "16px 20px",
        "background": "#fdf6ee",
        "color": "#666666",
        "margin": "20px 0",
        "font_size": "15px",
        "line_height": "1.8",
        "border_radius": "0 8px 8px 0"
    },
    "code_inline": {
        "background": "#f5ebe0",
        "color": "#8b4513",
        "padding": "2px 6px",
        "border_radius": "3px",
        "font_size": "14px",
        "font_family": "Consolas, Monaco, 'Courier New', monospace"
    },
    "code_block": {
        "background": "#faf5ef",
        "color": "#4a4a4a",
        "padding": "16px",
        "border_radius": "8px",
        "font_size": "13px",
        "line_height": "1.6",
        "margin": "20px 0",
        "font_family": "Consolas, Monaco, 'Courier New', monospace",
        "white_space": "pre-wrap",
        "word_break": "break-all",
        "border_top": "3px solid #d4a574"
    },
    "pre": {
        "margin": "20px 0",
        "padding": "0"
    },
    "img": {
        "max_width": "100%",
        "border_radius": "8px",
        "margin": "20px 0",
        "display": "block"
    },
    "hr": {
        "border": "none",
        "border_top": "1px solid #d4a574",
        "margin": "24px 0"
    },
    "ul": {
        "padding_left": "24px",
        "margin": "12px 0"
    },
    "ol": {
        "padding_left": "24px",
        "margin": "12px 0"
    },
    "li": {
        "margin": "8px 0",
        "line_height": "1.8"
    },
    "table": {
        "border-collapse": "collapse",
        "width": "100%",
        "margin": "16px 0",
        "font_size": "14px"
    },
    "th": {
        "background": "#fdf6ee",
        "border": "1px solid #d4a574",
        "padding": "10px 14px",
        "font_weight": "bold",
        "text_align": "left",
        "color": "#8b4513"
    },
    "td": {
        "border": "1px solid #d4a574",
        "padding": "10px 14px"
    },
    "emphasis": {
        "background": "#f5e6d0",
        "padding": "2px 6px",
        "color": "#8b4513"
    },
    "footer": {
        "text_align": "center",
        "margin": "40px 0 20px 0",
        "padding": "20px 0 0 0",
        "border_top": "1px solid #d4a574",
        "font_size": "14px",
        "color": "#999999",
        "line_height": "1.8"
    }
}
