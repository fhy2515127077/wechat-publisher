{
    "name": "报刊 editorial",
    "description": "报纸 editorial 风格、衬线字体、严肃正式、适合新闻评论",
    "body": {
        "max_width": "100%",
        "font_size": "15px",
        "color": "#1a1a1a",
        "line_height": "1.8",
        "font_family": "Georgia, 'Noto Serif SC', 'Source Han Serif SC', 'STSong', 'SimSun', serif",
        "letter_spacing": "0.3px",
        "word_break": "break-word",
        "padding": "0 8px",
        "background": "#ffffff",
        "text_align": "justify"
    },
    "title": {
        "font_size": "24px",
        "font_weight": "bold",
        "color": "#000000",
        "text_align": "left",
        "margin": "0 0 16px 0",
        "line_height": "1.3"
    },
    "author": {
        "font_size": "13px",
        "color": "#666666",
        "text_align": "left",
        "margin": "0 0 24px 0"
    },
    "date": {
        "font_size": "12px",
        "color": "#999999",
        "text_align": "left",
        "margin": "0 0 20px 0"
    },
    "h1": {
        "font_size": "20px",
        "font_weight": "bold",
        "color": "#000000",
        "margin": "32px 0 16px 0",
        "padding_bottom": "8px",
        "border_bottom": "3px solid #000000",
        "text_align": "left"
    },
    "h2": {
        "font_size": "18px",
        "font_weight": "bold",
        "color": "#000000",
        "margin": "28px 0 14px 0",
        "padding_bottom": "6px",
        "border_bottom": "1px solid #cccccc",
        "text_align": "left"
    },
    "h3": {
        "font_size": "16px",
        "font_weight": "bold",
        "color": "#1a1a1a",
        "margin": "24px 0 12px 0",
        "text_align": "left"
    },
    "p": {
        "margin": "0 0 20px 0",
        "line_height": "1.8",
        "text_indent": "2em"
    },
    "strong": {
        "color": "#000000",
        "font_weight": "bold",
        "background": "transparent",
        "padding": "0",
        "border_radius": "0"
    },
    "em": {
        "color": "#333333",
        "font_style": "italic"
    },
    "a": {
        "color": "#1a1a1a",
        "text-decoration": "underline"
    },
    "blockquote": {
        "border_left": "3px solid #000000",
        "padding": "12px 16px",
        "background": "#f9f9f9",
        "color": "#333333",
        "margin": "16px 0",
        "font_size": "15px",
        "line_height": "1.8",
        "border_radius": "0"
    },
    "code_inline": {
        "background": "#f0f0f0",
        "color": "#1a1a1a",
        "padding": "2px 6px",
        "border_radius": "3px",
        "font_size": "14px",
        "font_family": "Consolas, Monaco, 'Courier New', monospace"
    },
    "code_block": {
        "background": "#f5f5f5",
        "color": "#1a1a1a",
        "padding": "16px",
        "border_radius": "0",
        "font_size": "13px",
        "line_height": "1.6",
        "margin": "16px 0",
        "font_family": "Consolas, Monaco, 'Courier New', monospace",
        "white_space": "pre-wrap",
        "word_break": "break-all",
        "border_top": "2px solid #000000"
    },
    "pre": {
        "margin": "16px 0",
        "padding": "0"
    },
    "img": {
        "max_width": "100%",
        "border_radius": "0",
        "margin": "20px 0",
        "display": "block"
    },
    "hr": {
        "border": "none",
        "border_top": "2px solid #000000",
        "margin": "24px 0"
    },
    "ul": {
        "padding_left": "24px",
        "margin": "12px 0"
    },
    "ol": {
        "padding_left": "24px",
        "margin": "12px 0"
    },
    "li": {
        "margin": "6px 0",
        "line_height": "1.8"
    },
    "table": {
        "border-collapse": "collapse",
        "width": "100%",
        "margin": "16px 0",
        "font_size": "14px"
    },
    "th": {
        "background": "#f0f0f0",
        "border": "1px solid #cccccc",
        "padding": "8px 12px",
        "font_weight": "bold",
        "text_align": "left"
    },
    "td": {
        "border": "1px solid #cccccc",
        "padding": "8px 12px"
    },
    "emphasis": {
        "background": "#f0f0f0",
        "padding": "2px 4px",
        "color": ""
    },
    "footer": {
        "text_align": "center",
        "margin": "40px 0 20px 0",
        "padding": "20px 0 0 0",
        "border_top": "2px solid #000000",
        "font_size": "14px",
        "color": "#999999",
        "line_height": "1.8"
    }
}
