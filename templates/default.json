{
    "name": "极简黑白灰",
    "description": "黑白灰极简风，左侧竖线标题，干净利落",
    "body": {
        "max_width": "100%",
        "font_size": "15px",
        "color": "#333333",
        "line_height": "1.6",
        "font_family": "-apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
        "letter_spacing": "0.5px",
        "word_break": "break-word",
        "padding": "0 8px",
        "background": "#ffffff",
        "text_align": "justify"
    },
    "title": {
        "font_size": "22px",
        "font_weight": "bold",
        "color": "#1a1a1a",
        "text_align": "left",
        "margin": "0 0 24px 0",
        "line_height": "1.4"
    },
    "author": {
        "font_size": "13px",
        "color": "#999999",
        "text_align": "left",
        "margin": "0 0 24px 0"
    },
    "date": {
        "font_size": "12px",
        "color": "#bbbbbb",
        "text_align": "left",
        "margin": "0 0 20px 0"
    },
    "h1": {
        "font_size": "20px",
        "font_weight": "bold",
        "color": "#1a1a1a",
        "margin": "36px 0 16px 0",
        "padding": "0 0 0 12px",
        "border_left": "4px solid #333333",
        "text_align": "left"
    },
    "h2": {
        "font_size": "18px",
        "font_weight": "bold",
        "color": "#1a1a1a",
        "margin": "32px 0 14px 0",
        "padding": "0 0 0 12px",
        "border_left": "4px solid #333333",
        "text_align": "left"
    },
    "h3": {
        "font_size": "16px",
        "font_weight": "bold",
        "color": "#1a1a1a",
        "margin": "24px 0 12px 0",
        "text_align": "left"
    },
    "p": {
        "margin": "0 0 24px 0",
        "line_height": "1.6",
        "text_indent": "0"
    },
    "strong": {
        "color": "#1a1a1a",
        "font_weight": "bold",
        "background": "transparent",
        "padding": "0",
        "border_radius": "0"
    },
    "em": {
        "color": "#666666",
        "font_style": "italic"
    },
    "a": {
        "color": "#333333",
        "text-decoration": "underline"
    },
    "blockquote": {
        "border_left": "4px solid #cccccc",
        "padding": "16px 20px",
        "background": "#f9f9f9",
        "color": "#666666",
        "margin": "20px 0",
        "font_size": "15px",
        "line_height": "1.6",
        "border_radius": "0 8px 8px 0"
    },
    "code_inline": {
        "background": "#f0f0f0",
        "color": "#333333",
        "padding": "2px 6px",
        "border_radius": "3px",
        "font_size": "14px",
        "font_family": "Consolas, Monaco, 'Courier New', monospace"
    },
    "code_block": {
        "background": "#f5f5f5",
        "color": "#333333",
        "padding": "16px",
        "border_radius": "8px",
        "font_size": "13px",
        "line_height": "1.6",
        "margin": "20px 0",
        "font_family": "Consolas, Monaco, 'Courier New', monospace",
        "white_space": "pre-wrap",
        "word_break": "break-all",
        "border_top": "3px solid #999999"
    },
    "pre": {
        "margin": "20px 0",
        "padding": "0"
    },
    "img": {
        "max_width": "100%",
        "border_radius": "8px",
        "margin": "20px 0",
        "display": "block"
    },
    "hr": {
        "border": "none",
        "border_top": "1px solid #eee",
        "margin": "24px 0"
    },
    "ul": {
        "padding_left": "24px",
        "margin": "12px 0"
    },
    "ol": {
        "padding_left": "24px",
        "margin": "12px 0"
    },
    "li": {
        "margin": "8px 0",
        "line_height": "1.6"
    },
    "table": {
        "border-collapse": "collapse",
        "width": "100%",
        "margin": "16px 0",
        "font_size": "14px"
    },
    "th": {
        "background": "#f5f5f5",
        "border": "1px solid #ddd",
        "padding": "10px 14px",
        "font_weight": "bold",
        "text_align": "left"
    },
    "td": {
        "border": "1px solid #ddd",
        "padding": "10px 14px"
    },
    "emphasis": {
        "background": "#e9e8e8",
        "padding": "2px 6px",
        "color": ""
    },
    "footer": {
        "text_align": "center",
        "margin": "40px 0 20px 0",
        "padding": "20px 0 0 0",
        "border_top": "1px solid #eee",
        "font_size": "14px",
        "color": "#999999",
        "line_height": "1.6"
    }
}
